{
  "name": "its-going-down",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "It's Going Down — a downhill arcade game for kids of all ages.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "format": "prettier --write",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:fast": "npm run lint && npm run typecheck && npm test",
    "check:staged": "node scripts/check-staged.mjs",
    "prepare": "node scripts/install-hooks.mjs"
  },
  "devDependencies": {
    "@types/three": "^0.185.4",
    "oxlint": "^1.79.0",
    "prettier": "^3.6.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "three": "^0.185.1"
  }
}
